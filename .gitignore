# Whitelist: ignore everything except what the module is built from.
# Local artifacts (research/, scripts/, api-catalog/, bin/, .tmp/, ...)
# are ignored by default instead of each needing its own rule.
/*
!/.gitignore
!/.github/
!/.goreleaser.yml
!/LICENSE
!/README.md
!/go.mod
!/go.sum
!/main.go
!/cmd/
!/internal/
!/docs/
!/scripts/
/scripts/*
!/scripts/install.sh

# Local research artifacts living inside whitelisted folders
/docs/exigo-api-catalog.md

# Junk at any depth
*.local
*.test
*.out
*.exe
.DS_Store
